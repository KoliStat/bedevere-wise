# Copy this file to `.env.local` and fill in values for local development.
# Vite inlines any VITE_*-prefixed var into the bundle at build time.

# Source URL for the stats_duck (ggsql VISUALIZE) DuckDB extension.
# Default (unset): the bundled copy committed under
# public/extensions/stats-duck/, served same-origin at
# /extensions/stats-duck by the dev server and production build alike.
# Overrides can be absolute or page-relative (the runtime prefixes
# window.location.origin).
#
# To test a local the-stats-duck build, either copy it over the bundled
# file (git shows the diff — commit it or restore), or leave the bundled
# copy pristine and junction a sibling dir. Everything under
# public/extensions/ EXCEPT stats-duck/ is gitignored, so:
#   1. mklink /J public\extensions\stats-duck-dev \
#        C:\path\to\the-stats-duck\build\wasm_eh\repository
#      (Windows; on macOS/Linux: ln -s for the same effect)
#   2. Set VITE_STATS_DUCK_URL=/extensions/stats-duck-dev below.
VITE_STATS_DUCK_URL=
